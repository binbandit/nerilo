{
  "name": "nerilo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "daemon": "bun apps/daemon/src/index.ts",
    "web": "bun --bun apps/web/node_modules/next/dist/bin/next dev apps/web --hostname 127.0.0.1 --port ${NERILO_WEB_PORT:-5185}",
    "build": "bun run --cwd packages/theme build && bun --bun apps/web/node_modules/next/dist/bin/next build apps/web",
    "typecheck": "bun --bun apps/web/node_modules/next/dist/bin/next typegen apps/web && tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "bun test --preload ./scripts/testing/setup.ts apps/daemon/src apps/web/src containers",
    "image:build": "docker build -t nerilo-agent:1 -f containers/Dockerfile containers",
    "test:docker": "bun scripts/smoke/docker-smoke.ts",
    "test:harnesses": "bun scripts/smoke/harness-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run --cwd packages/theme check",
    "lint": "eslint apps/web/src packages/theme/preview/src --max-warnings 0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "26.6.2",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.9.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
